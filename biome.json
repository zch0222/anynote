{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "ignore": [
      ".next",
      ".turbo",
      "apps/cli/src/bundled.ts",
      "apps/web-legacy",
      "apps/web/.next",
      "apps/web/e2e/.auth",
      "apps/web/e2e/.output",
      "apps/web/e2e/.ui-capture",
      "apps/web/e2e/.ui-supplement",
      "apps/web/playwright-report",
      "apps/web/public/pdf.worker.min.mjs",
      "apps/web/src/components/ui",
      "apps/web/src/styles/katex.css",
      "apps/web/test-results",
      "dist",
      "node_modules",
      "openapi/specs",
      "packages/api-client/src"
    ]
  }
}
