# ============================================================
# Anynote Docker Compose 环境变量
# 使用方法：cp .env.example .env，然后修改 .env 中的值
# .env 已被 .gitignore 忽略，不会提交到版本库
# ============================================================

# -------- 必须修改（生产/对外暴露环境）--------

# JWT 签名密钥，建议使用随机字符串（至少 32 位）
# 生成命令：openssl rand -hex 32
JWT_SECRET=

# XXL-Job 执行器与调度中心通信 Token
XXL_JOB_ADMIN_ACCESSTOKEN=

# MySQL root 密码（Nacos、XXL-Job 初始化使用）
MYSQL_ROOT_PASSWORD=

# MySQL 应用账户密码（所有微服务使用）
MYSQL_APP_PASSWORD=

# MinIO 对象存储密码
MINIO_ROOT_PASSWORD=

# 生产必须非空；本机 dev 使用 YAML 默认值，不读取本文件。
REDIS_PASSWORD=

# -------- 可选修改 --------

# MySQL 应用账户名
MYSQL_APP_USER=anynote

# 数据库名
MYSQL_DATABASE=anynote

# MinIO 用户名
MINIO_ROOT_USER=anynote

# Nacos 命名空间 ID
NACOS_NAMESPACE=
NACOS_PROD_CONFIG_DIR=/etc/anynote/nacos-prod

# Spring Profile（dev / prod）
SPRING_PROFILES_ACTIVE=prod

# JVM 参数
JAVA_OPTS=-Xms256m -Xmx512m

# Python AI 服务地址（宿主机运行时默认值即可）
AI_FASTAPI_ADDRESS=http://host.docker.internal:8000

# 前端与协同：域名需与容器外 Nginx 一致。NEXT_PUBLIC_* 更改后必须重新构建镜像。
NEXT_PUBLIC_APP_URL=https://notes.example.com
NEXT_PUBLIC_COLLAB_WS_URL=wss://notes.example.com/collab
COLLAB_TOKEN_SECRET=
# WEB/COLLAB_BIND_IP 默认回环；独立 Nginx 主机时填 Docker 主机私网 IP，防火墙仅放行 Nginx。
WEB_BIND_IP=127.0.0.1
WEB_PORT=3000
COLLAB_BIND_IP=127.0.0.1
COLLAB_PORT=1234

# 发布镜像标签必须固定；不要用 local/latest 发布生产。
APP_IMAGE_PREFIX=anynote
APP_IMAGE_TAG=
# 填当前部署验证过的完整 MinIO RELEASE 标签，禁止生产隐式拉 latest。
MINIO_VERSION=
