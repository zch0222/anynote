# syntax=docker/dockerfile:1
# 协同编辑 WebSocket 服务（apps/collab）。构建上下文是仓库根目录。
#
# 协同服务依赖 workspace 包 @anynote/editor-core（TS 源码，与前端共用编辑器 schema 与
# Markdown 规则），因此按 pnpm workspace 安装，再用 tsup 把源码连同 editor-core 打成单文件；
# 运行阶段只带 `pnpm deploy --prod` 产出的生产依赖（jsdom、ws 在产物里是外部依赖）。
#
# 构建时忽略规则在 Dockerfile.collab.dockerignore（仓库根的 .dockerignore 是给 Java 构建用的，
# 它把整个 apps/ 排除了）。

FROM node:22-alpine AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/collab/package.json ./apps/collab/package.json
COPY packages/editor-core/package.json ./packages/editor-core/package.json
COPY packages/tsconfig ./packages/tsconfig
RUN --mount=type=cache,id=anynote-collab-pnpm,target=/pnpm/store \
    pnpm config set store-dir /pnpm/store \
    && pnpm install --frozen-lockfile --filter @anynote/collab...

COPY packages/editor-core ./packages/editor-core
COPY apps/collab/tsconfig.json apps/collab/tsup.config.ts ./apps/collab/
COPY apps/collab/src ./apps/collab/src
RUN pnpm --filter @anynote/collab build
RUN --mount=type=cache,id=anynote-collab-pnpm,target=/pnpm/store \
    pnpm --filter @anynote/collab deploy --prod /deploy


FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production TZ=Asia/Shanghai

COPY --from=build /deploy/package.json ./package.json
COPY --from=build /deploy/node_modules ./node_modules
COPY --from=build /workspace/apps/collab/dist ./dist

# 应急落盘目录（COLLAB_PERSISTENCE_DIR）要能被 node 用户写入
RUN mkdir -p /data && chown -R node:node /data
USER node
VOLUME ["/data"]

EXPOSE 1234
CMD ["node", "dist/main.js"]
