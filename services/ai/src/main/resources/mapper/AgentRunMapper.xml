<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anynote.ai.mapper.AgentRunMapper">

    <resultMap id="AgentRunResultMap" type="com.anynote.ai.model.po.AgentRunPO">
        <id property="id" column="id" />
        <result property="runId" column="run_id" />
        <result property="conversationId" column="conversation_id" />
        <result property="userId" column="user_id" />
        <result property="agentName" column="agent_name" />
        <result property="agentVersion" column="agent_version" />
        <result property="model" column="model" />
        <result property="provider" column="provider" />
        <result property="state" column="state" />
        <result property="outcome" column="outcome" />
        <result property="tokenUsage" column="token_usage" />
        <result property="durationMs" column="duration_ms" />
        <result property="toolCalls" column="tool_calls" />
        <result property="firstOutputMs" column="first_output_ms" />
        <result property="startedAt" column="started_at" />
        <result property="finishedAt" column="finished_at" />
    </resultMap>

    <select id="selectOwned" resultMap="AgentRunResultMap">
        SELECT id, run_id, conversation_id, user_id, agent_name, agent_version, model, provider,
               state, outcome, token_usage, duration_ms, tool_calls, first_output_ms, started_at, finished_at
        FROM a_agent_run
        WHERE run_id = #{runId} AND user_id = #{userId}
        LIMIT 1
    </select>

    <select id="selectAdminList" resultMap="AgentRunResultMap">
        SELECT id, run_id, conversation_id, user_id, agent_name, agent_version, model, provider,
               state, outcome, token_usage, duration_ms, tool_calls, first_output_ms, started_at, finished_at
        FROM a_agent_run
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="runId != null and runId != ''">
                AND run_id LIKE CONCAT(#{runId}, '%')
            </if>
            <if test="outcome != null and outcome != ''">
                AND outcome = #{outcome}
            </if>
            <if test="startedFrom != null">
                AND started_at &gt;= #{startedFrom}
            </if>
            <if test="startedTo != null">
                AND started_at &lt;= #{startedTo}
            </if>
        </where>
        ORDER BY started_at DESC
    </select>

</mapper>
