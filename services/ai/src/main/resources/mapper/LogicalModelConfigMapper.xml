<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anynote.ai.mapper.LogicalModelConfigMapper">

    <resultMap id="LogicalModelConfigResultMap" type="com.anynote.ai.model.po.LogicalModelConfigPO">
        <id property="id" column="id" />
        <result property="logicalName" column="logical_name" />
        <result property="providerKey" column="provider_key" />
        <result property="modelName" column="model_name" />
        <result property="dimensions" column="dimensions" />
        <result property="reasoningFormat" column="reasoning_format" />
        <result property="reasoningPassthrough" column="reasoning_passthrough" />
        <result property="supportsVision" column="supports_vision" />
        <result property="enabled" column="enabled" />
        <result property="version" column="version" />
        <result property="createBy" column="create_by" />
        <result property="updateBy" column="update_by" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="allColumns">
        id, logical_name, provider_key, model_name, dimensions,
        reasoning_format, reasoning_passthrough, supports_vision,
        enabled, version, create_by, update_by, create_time, update_time
    </sql>

    <select id="selectByLogicalName" resultMap="LogicalModelConfigResultMap">
        SELECT
            <include refid="allColumns" />
        FROM a_logical_model
        WHERE logical_name = #{logicalName}
        LIMIT 1
    </select>

    <select id="selectAll" resultMap="LogicalModelConfigResultMap">
        SELECT
            <include refid="allColumns" />
        FROM a_logical_model
        ORDER BY logical_name ASC
    </select>

</mapper>
