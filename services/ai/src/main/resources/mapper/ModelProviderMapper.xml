<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anynote.ai.mapper.ModelProviderMapper">

    <resultMap id="ModelProviderResultMap" type="com.anynote.ai.model.po.ModelProviderPO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="provider_key" property="providerKey" jdbcType="VARCHAR"/>
        <result column="display_name" property="displayName" jdbcType="VARCHAR"/>
        <result column="protocol" property="protocol" jdbcType="VARCHAR"/>
        <result column="base_url" property="baseUrl" jdbcType="VARCHAR"/>
        <result column="api_key_cipher" property="apiKeyCipher" jdbcType="VARCHAR"/>
        <result column="models" property="modelsJson" jdbcType="VARCHAR"/>
        <result column="data_egress_allowed" property="dataEgressAllowed" jdbcType="TINYINT"/>
        <result column="enabled" property="enabled" jdbcType="TINYINT"/>
        <result column="version" property="version" jdbcType="BIGINT"/>
        <result column="create_by" property="createBy" jdbcType="BIGINT"/>
        <result column="update_by" property="updateBy" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, provider_key, display_name, protocol, base_url, api_key_cipher, models,
        data_egress_allowed, enabled, version, create_by, update_by, create_time, update_time
    </sql>

    <select id="selectAll" resultMap="ModelProviderResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM a_model_provider
        ORDER BY id ASC
    </select>

    <select id="selectByProviderKey" resultMap="ModelProviderResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM a_model_provider
        WHERE provider_key = #{providerKey}
        LIMIT 1
    </select>

</mapper>
